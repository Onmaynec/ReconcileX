# Local development. Replace every value with your own generated secret.
DB_PASSWORD=replace-with-a-long-random-db-password
JWT_SECRET=replace-with-64-random-characters-long-jwt-secret-not-for-production
S3_ACCESS_KEY=reconcilex-local
S3_SECRET_KEY=replace-with-a-long-random-s3-secret
DEMO_PASSWORD=replace-with-a-strong-demo-password
RISK_THRESHOLD_MINOR=10000000

# Backups: one immediate snapshot at startup, then every day at UTC hour.
BACKUP_KEEP=7
BACKUP_HOUR_UTC=3

# Off-site backups are opt-in via compose.offsite.yaml; use a DIFFERENT remote account.
# Never commit real credentials. Provision HTTPS storage with bucket versioning and Object Lock.
# OFFSITE_S3_ENDPOINT=https://offsite.example.org
# OFFSITE_S3_BUCKET=reconcilex-immutable-backups
# OFFSITE_S3_ACCESS_KEY=use-a-dedicated-upload-read-credential
# OFFSITE_S3_SECRET_KEY=generate-a-unique-key
# OFFSITE_MANIFEST_HMAC_KEY=generate-64-random-characters-offline-and-protect-it
# OFFSITE_S3_REGION=us-east-1
# OFFSITE_S3_PREFIX=reconcilex
# OFFSITE_S3_ENCRYPTION=AES256
# OFFSITE_S3_KMS_KEY_ID=                  # required only for aws:kms
# OFFSITE_MAX_AGE_HOURS=36
# OFFSITE_ALERT_WEBHOOK_URL=https://monitor.example.org/backup-events
